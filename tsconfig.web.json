{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"],
      "@compartilhado/*": ["./src/compartilhado/*"]
    }
  },
  "include": ["./src/renderer/src/**/*", "src/preload/*.d.ts", "src/compartilhado/**/*"]
}
